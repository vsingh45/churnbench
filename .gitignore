__pycache__/
*.py[cod]
.venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/
data/*
!data/.gitkeep
!data/full/
data/full/*
# The ground-truth ledger every gold answer derives from is committed so
# reviewers can verify the paper's data, not just its arithmetic. Everything
# else generated under data/full/ (staged fabric exports, docs corpus,
# raw results, task set) stays gitignored.
!data/full/ledger.jsonl
!data/full/README.md
poetry.lock
.DS_Store

# Generated contract corpus — the fabric's document layer. Projector.project_docs()
# wipes and rebuilds this on every run, so it is output, not source.
docs/

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
paper/*.pdf
# Current submission draft is a deliberate exception — needed for the arXiv
# endorsement request and as a stable, citable artifact.
!paper/churnbench-aixse.pdf

# IEEE Access class file — not freely redistributable; copy from author kit
paper/ieeeaccess.cls

# Experiment results — raw outputs gitignored; only deliberately committed
# result data goes in. Two naming conventions are tracked:
#   results/summary_*.json  — lightweight aggregate summaries (verdict counts, no per-task rows)
#   results/*_full.json     — complete per-task result sets (all fields, full evidentiary detail)
results/*.json
!results/summary_*.json
!results/*_full.json
results/**/*.traces.jsonl
results/**/*.ckpt.json
